# ── Secrets ──
# Flask session signing key; provider credentials live in the database, not files.
secret_key.txt
secrets/
.env
.env.*
*.pem
*.key

# ── Databases and user data ──
# Accounts, résumés, cover letters, search results, application history.
data/
*.db
*.db.*
*.sqlite
*.sqlite3

# ── Legacy per-user dashboards (other people's search results) ──
legacy_output/
configs/

# ── Runtime state and output ──
logs/
*.log
*.pid
gunicorn.ctl
backups/

# ── Timestamped backups ──
*.bak
*.backup_*
*_backup_*

# ── Planning / working notes (not documentation) ──
HANDOFF.md
AGENTS.md
CLAUDE.md
*_PLAN*.md

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Tooling / OS cruft ──
.claude/
.vscode/
desktop.ini
Thumbs.db
